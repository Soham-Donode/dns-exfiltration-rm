# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual environments
env/
venv/
.venv/
ENV/

# Jupyter Notebook checkpoints
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# Data directories (keep structure via .gitkeep)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# PCAPs, captures, and datasets
*.pcap
*.pcapng
*.cap
*.csv
*.tsv
*.parquet
*.tar.gz
*.zip
*.7z

# Model artifacts and checkpoints (keep structure via .gitkeep)
models/*
!models/.gitkeep

# Logs & temp files
logs/
*.log

# OS & Editor specific files
.DS_Store
.vscode/
.idea/
*.swp
*.swo
*~
